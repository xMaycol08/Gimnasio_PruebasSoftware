          "raw": "{\n  \"id_cliente\": {{idCliente}},\n  \"id_membresia\": {{idMembresia}},\n  \"fecha_pago\": \"{{fechaPago}}\",\n  \"monto\": {{precio}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
