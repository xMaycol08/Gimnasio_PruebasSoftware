          "raw": "{\n  \"nombre\": \"Cliente de pagos\",\n  \"cedula\": \"{{cedulaCliente}}\",\n  \"telefono\": \"0999999999\",\n  \"email\": \"{{emailCliente}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "1. Registrar pago correcto (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fecha de pago aleatoria para poder repetir la colección sin chocar con pagos duplicados",
              "const dia = new Date(Date.UTC(2020, 0, 1) + Math.floor(Math.random() * 3650) * 86400000);",
              "pm.collectionVariables.set('fechaPago', dia.toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "const pago = pm.response.json();",
              "pm.test('Estado PAGADO por defecto', () => pm.expect(pago.estado).to.eql('PAGADO'));",
              "pm.test('Calcula el vencimiento', () => pm.expect(pago.fecha_vencimiento > pago.fecha_pago).to.be.true);",
              "pm.collectionVariables.set('idPago', pago.id_pago);",
              "pm.collectionVariables.set('fechaVencimiento', pago.fecha_vencimiento);",
              "const siguiente = new Date(pago.fecha_vencimiento + 'T00:00:00Z');",
              "siguiente.setUTCDate(siguiente.getUTCDate() + 1);",
              "pm.collectionVariables.set('diaSiguiente', siguiente.toISOString().slice(0, 10));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pagos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
