{
  "info": {
    "name": "04 - Accesos",
    "description": "Colección de pruebas para el módulo de Accesos (registro de entrada, salida, permanencia, listado y clientes dentro).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "idCliente",
      "value": "1"
    },
    {
      "key": "idAcceso",
      "value": ""
    },
    {
      "key": "fechaEntrada",
      "value": "2026-03-01T10:00:00.000Z"
    },
    {
      "key": "fechaSalida",
      "value": "2026-03-01T11:30:00.000Z"
    }
  ],
  "item": [
    {
      "name": "1. POST /api/accesos/entrada (201 Éxito)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": {{idCliente}},\n  \"fecha_hora\": \"{{fechaEntrada}}\"\n}"
        },
        "url": "{{baseUrl}}/api/accesos/entrada"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve el id_acceso creado', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id_acceso');",
              "  pm.collectionVariables.set('idAcceso', body.id_acceso);",
              "});",
              "pm.test('fecha_hora_salida es null al entrar', () => {",
              "  pm.expect(pm.response.json().fecha_hora_salida).to.be.null;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. POST /api/accesos/entrada - Error 400 (id_cliente inválido)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": \"invalido\"\n}"
        },
        "url": "{{baseUrl}}/api/accesos/entrada"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Contiene mensaje descriptivo de error', () => {",
              "  pm.expect(pm.response.json()).to.have.property('error');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. POST /api/accesos/entrada - Error 404 (cliente inexistente)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": 999999\n}"
        },
        "url": "{{baseUrl}}/api/accesos/entrada"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('Mensaje de cliente no existente', () => {",
              "  pm.expect(pm.response.json().error).to.include('no existe');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. POST /api/accesos/entrada - Error 409 (ya tiene entrada abierta)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": {{idCliente}}\n}"
        },
        "url": "{{baseUrl}}/api/accesos/entrada"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Mensaje de entrada abierta previa', () => {",
              "  pm.expect(pm.response.json().error).to.include('ya tiene una entrada abierta');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. POST /api/accesos/entrada - Error 422 (membresía no vigente)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": {{idCliente}},\n  \"fecha_hora\": \"2035-01-01T10:00:00Z\"\n}"
        },
        "url": "{{baseUrl}}/api/accesos/entrada"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 409 o 422 según estado del cliente', () => {",
              "  pm.expect([409, 422]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. GET /api/accesos/dentro (200 Éxito)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accesos/dentro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve un arreglo con clientes dentro', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. GET /api/accesos (200 Éxito)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accesos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve la lista histórica de accesos', () => {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. GET /api/accesos con filtro ?id_cliente= (200 Éxito)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accesos?id_cliente={{idCliente}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve lista filtrada por cliente', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.be.an('array');",
              "  body.forEach(item => pm.expect(String(item.id_cliente)).to.eql(String(pm.collectionVariables.get('idCliente'))));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. GET /api/accesos con filtro inválido (400 Bad Request)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accesos?id_cliente=invalido"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400 Bad Request', () => pm.response.to.have.status(400));",
