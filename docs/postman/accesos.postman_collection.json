              "  pm.expect(pm.response.json()).to.have.property('error');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. POST /api/accesos/salida - Error 422 (salida anterior a entrada)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": {{idCliente}},\n  \"fecha_hora\": \"2026-03-01T09:00:00.000Z\"\n}"
        },
        "url": "{{baseUrl}}/api/accesos/salida"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('Mensaje de salida anterior a entrada', () => {",
              "  pm.expect(pm.response.json().error).to.include('no puede ser anterior');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. POST /api/accesos/salida (200 Éxito)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": {{idCliente}},\n  \"fecha_hora\": \"{{fechaSalida}}\"\n}"
        },
        "url": "{{baseUrl}}/api/accesos/salida"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Incluye fecha_hora_salida', () => {",
              "  pm.expect(pm.response.json().fecha_hora_salida).to.not.be.null;",
              "});",
              "pm.test('Incluye permanencia_minutos calculada', () => {",
              "  pm.expect(pm.response.json()).to.have.property('permanencia_minutos');",
              "  pm.expect(pm.response.json().permanencia_minutos).to.eql(90);",
              "});"
            ]
          }
        }
      ]
    },
