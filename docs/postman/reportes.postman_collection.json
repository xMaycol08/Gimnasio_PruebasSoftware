  },
  "item": [
    {
      "name": "1. Por vencer, por defecto 7 días (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve fecha, dias, total y clientes', () => pm.expect(pm.response.json()).to.have.keys('fecha', 'dias', 'total', 'clientes'));",
              "pm.test('dias por defecto es 7', () => pm.expect(pm.response.json().dias).to.eql(7));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reportes/vencimientos/por-vencer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reportes",
            "vencimientos",
            "por-vencer"
          ]
        }
      }
    },
    {
