# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NO se sube a Git (está en .gitignore).
# Guía paso a paso: docs/guias/00-inicio-rapido.md (sección 3)

PORT=3000
NODE_ENV=development

# Cadena de conexión de Supabase: Connect -> Direct -> "Session pooler".
# Formato:  postgresql://postgres.<REF_PROYECTO>:<CONTRASEÑA>@<HOST_POOLER>:5432/postgres
# - <REF_PROYECTO>: aparece en la URL del dashboard (supabase.com/dashboard/project/<REF_PROYECTO>)
# - <CONTRASEÑA>: la contraseña de la base (si tiene símbolos como @ # / : ?, ver la guía)
# - <HOST_POOLER>: cópialo tal cual del panel de Supabase (algo como aws-1-us-east-1.pooler.supabase.com)
DATABASE_URL=postgresql://postgres.REF_PROYECTO:CONTRASENA@HOST_POOLER:5432/postgres
