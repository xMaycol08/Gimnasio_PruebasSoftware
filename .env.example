# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NO se sube a Git (está en .gitignore).

PORT=3000
NODE_ENV=development

# Cadena de conexión de Supabase (Connect -> Transaction pooler).
# Reemplaza [YOUR-PASSWORD] por la contraseña real de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
